# Copy this file to .env for local dev with `vercel dev`, and set the same
# values as Environment Variables in the Vercel project dashboard for deployment.

# Required: your Anthropic API key (kept server-side, never exposed to students)
ANTHROPIC_API_KEY=

# Optional: model override. Defaults to claude-sonnet-5 if unset.
# Use a cheaper/faster model (e.g. claude-haiku-4-5-20251001) if class usage volume is a cost concern.
CLAUDE_MODEL=claude-sonnet-5

# Optional: shared passphrase students must enter once in the sidebar before
# chatting. Protects your API budget if the site URL leaks beyond your class.
# Leave unset to disable this check entirely.
CLASS_ACCESS_CODE=
